<!DOCTYPE web-app PUBLIC
        "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
        "http://java.sun.com/dtd/web-app_2_3.dtd">

<web-app>
  <display-name>Hostel Outpass Application</display-name>

  <servlet>
    <servlet-name>submitRegisterServlet</servlet-name>
    <servlet-class>submitRegisterServlet</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>submitRegisterServlet</servlet-name>
    <url-pattern>/submitRegisterServlet</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>FilterExecutiveHistory</servlet-name>
    <url-pattern>/FilterExecutiveHistory</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>FilterRcHistory</servlet-name>
    <url-pattern>/FilterRcHistory</url-pattern>
  </servlet-mapping>

  <!-- Welcome file for root URL -->
  <welcome-file-list>
    <welcome-file>mithosteloutpassmangement-production-80f1.up.railway.app/</welcome-file>
  </welcome-file-list>

</web-app>
